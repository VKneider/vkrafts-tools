{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true
  },
  "include": [
    "src/Components/**/*.js",
    "src/**/*.d.ts",
    "src/App/**/*.js",
    "src/routes.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/libs/**",
    "tests/**",
    "**/*.spec.js",
    "src/public/**"
  ]
}
